    "## Step 6. 시차 보정 전/후 유사도(상관계수) 비교 분석 (Correlation Lift Analysis)\n",
    "\n",
    "상품별로 동적 시차($d$)를 적용하여 앱 관심도 시계열을 이동(Shift)시켰을 때,\n",
    "실제 오프라인 판매량 추이와의 상관관계(Pearson Correlation)가 대략 얼마나 유의미하게 개선되는지 분석합니다."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "correlation_results = []\n",
    "\n",
    "for code in valid_codes:\n",
    "    ts = time_series_data[code]\n",
    "    app_ts = ts[\"app_view\"]\n",
    "    pos_ts = ts[\"pos_qty\"]\n",
    "    \n",
    "    d_lag = int(round(dynamic_lags.get(code, 0.0)))\n",
    "    \n",
    "    # 1) 시차 보정 전 피어슨 상관계수\n",
    "    # 표준편차가 0일 경우 상관계수 NaN 방지\n",
    "    if np.std(app_ts) == 0 or np.std(pos_ts) == 0:\n",
    "        corr_raw = 0.0\n",
    "        corr_shifted = 0.0\n",
    "    else:\n",
    "        corr_raw = np.corrcoef(app_ts, pos_ts)[0, 1]\n",
    "        if np.isnan(corr_raw): corr_raw = 0.0\n",
    "        \n",
    "        # 2) 시차 보정 후 상관계수 (App 시계열을 d일 만큼 shift하여 매핑)\n",
    "        # pandas Series를 사용해 편하게 shift 처리를 수행합니다.\n",
    "        app_series = pd.Series(app_ts)\n",
    "        # d_lag가 양수이면 app이 선행하므로 app을 오른쪽(미래)으로 shift하여 pos와 시점을 맞춰줍니다.\n",
    "        app_shifted = app_series.shift(periods=d_lag).fillna(0.0).values\n",
    "        \n",
    "        if np.std(app_shifted) == 0:\n",
    "            corr_shifted = 0.0\n",
    "        else:\n",
    "            corr_shifted = np.corrcoef(app_shifted, pos_ts)[0, 1]\n",
    "            if np.isnan(corr_shifted): corr_shifted = 0.0\n("
    "            \n",
    "    correlation_results.append({\n",
    "        \"상품코드\": code,\n",
    "        \"lag\": d_lag,\n",
    "        \"corr_raw\": corr_raw,\n",
    "        \"corr_shifted\": corr_shifted,\n",
    "        \"corr_lift\": corr_shifted - corr_raw\n",
    "    })\n",
    "\n",
    "df_corr = pd.DataFrame(correlation_results)\n",
    "print(df_corr.describe())"
   ]
  },
