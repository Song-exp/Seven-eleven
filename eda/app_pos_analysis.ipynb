    "plt.plot(pos_sample_norm, label=\"POS 매출량 (Raw)\", color=\"darkorange\", alpha=0.8, linewidth=2)\n",
    "plt.title(f\"보정 후 (Shifted) - 시차 적용 완료\\n상관계수: {df_corr.loc[df_corr['상품코드'] == top_lift_product, 'corr_shifted'].values[0]:.3f} (Lift: +{top_lift_val:.3f})\")\n",
    "plt.xlabel(\"출시 후 경과 일수 (Day)\")\n",
    "plt.legend()\n",
