    "# 시차 보정으로 유사도가 극대화된 대표 사례 상품 시각화\n",
    "top_lift_product = df_corr.sort_values(by=\"corr_lift\", ascending=False).iloc[0][\"상품코드\"]\n",
    "top_lift_val = df_corr.sort_values(by=\"corr_lift\", ascending=False).iloc[0][\"corr_lift\"]\n",
    "best_lag = int(round(dynamic_lags[top_lift_product]))\n",
    "\n",
    "ts_sample = time_series_data[top_lift_product]\n",
    "app_sample_norm = (ts_sample[\"app_view\"] - np.mean(ts_sample[\"app_view\"])) / (np.std(ts_sample[\"app_view\"]) + 1e-8)\n",
    "pos_sample_norm = (ts_sample[\"pos_qty\"] - np.mean(ts_sample[\"pos_qty\"])) / (np.std(ts_sample[\"pos_qty\"]) + 1e-8)\n",
    "app_sample_shifted = pd.Series(app_sample_norm).shift(periods=best_lag).fillna(0.0).values\n",
    "\n",
    "plt.figure(figsize=(14, 5))\n",
    "\n",
    "plt.subplot(1, 2, 1)\n",
