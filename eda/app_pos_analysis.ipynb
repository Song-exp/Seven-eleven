    "plt.title(f\"보정 전 (Raw) - 상품코드: {top_lift_product}\\n상관계수: {df_corr.loc[df_corr['상품코드'] == top_lift_product, 'corr_raw'].values[0]:.3f}\")\n",
    "plt.xlabel(\"출시 후 경과 일수 (Day)\")\n",
    "plt.ylabel(\"정규화 수치 (Z-Score)\")\n",
    "plt.legend()\n",
    "\n",
