# .env.example
# ────────────────────────────────────────────────────────────────────────
# 이 파일을 복사하여 .env로 저장 후 값을 설정하세요.
# cp .env.example .env
# ────────────────────────────────────────────────────────────────────────

# ── [활성] DeepSeek API 설정 ──────────────────────────────────────────
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx   # DeepSeek 콘솔에서 발급
DEEPSEEK_MODEL=deepseek-chat                   # deepseek-chat (V3) 또는 deepseek-reasoner (R1)
DEEPSEEK_TIMEOUT=60                            # 초 단위

# ── [비활성] 기존 Ollama / Remote Gemma 설정 ─────────────────────────
# LLM_MODE=local
# OLLAMA_URL=http://localhost:11434/api/generate
# OLLAMA_MODEL=gemma4:e4b
# REMOTE_LLM_URL=https://yyyy.ngrok-free.app
# REMOTE_LLM_KEY=GEMMA_KEY_2026

# ── 대시보드 인증 키 ──────────────────────────────────────────────────
# DEV_KEY: 개발 환경에서 인증 우회 (변경 금지)
# 운영 배포 시 강력한 랜덤 문자열로 교체 후 Vercel 환경변수에도 동일 설정
DASHBOARD_SECRET_KEY=DEV_KEY
